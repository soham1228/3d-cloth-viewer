# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-garments-bucket
S3_PREFIX=garments/3d-models

# Optional: CloudFront or custom public CDN base URL (if bucket is private/behind CDN)
# S3_PUBLIC_BASE_URL=https://cdn.yourdomain.com
S3_USE_PRESIGNED_URL=false
S3_PRESIGNED_EXPIRY_SECONDS=3600

# Local output directory for generated .glb files (used for local preview or fallback)
LOCAL_OUTPUT_DIR=output_models
